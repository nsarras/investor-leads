# Copy this file to .env and fill in your own keys. .env is git-ignored; never commit it.

# Required. Classifies posts and plans the searches. https://console.anthropic.com
ANTHROPIC_API_KEY=

# Optional. Official X API bearer token (pay-per-use credits). https://console.x.com
# Leave empty to skip X.
X_BEARER_TOKEN=

# Optional. Apify API token, used to search public LinkedIn posts. https://console.apify.com
# Leave empty to skip LinkedIn.
APIFY_API_TOKEN=

# Optional. Only needed for --email. Any SMTP server works.
# Gmail: host smtp.gmail.com, port 587, your address as the username, and an app password
# (https://myaccount.google.com/apppasswords; needs 2-Step Verification). Not your normal password.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
# Optional. The address the email is sent from; defaults to SMTP_USERNAME.
EMAIL_FROM=
# Optional. Comma-separated recipients; overrides `email.to` in config.yaml.
EMAIL_TO=
